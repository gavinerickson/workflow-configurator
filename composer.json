{
    "name": "gavinerickson/workflow-configurator",
    "description": "Operator-editable workflow graphs over Symfony Workflow: definitions, places and transitions as Doctrine entities, compiled into workflows at runtime.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Gavin Erickson"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/collections": "^2.2",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.2",
        "psr/log": "^3.0",
        "symfony/cache-contracts": "^3.0",
        "symfony/config": "^7.2 || ^8.0",
        "symfony/dependency-injection": "^7.2 || ^8.0",
        "symfony/event-dispatcher": "^7.2 || ^8.0",
        "symfony/expression-language": "^7.2 || ^8.0",
        "symfony/http-kernel": "^7.2 || ^8.0",
        "symfony/messenger": "^7.2 || ^8.0",
        "symfony/validator": "^7.2 || ^8.0",
        "symfony/workflow": "^7.2 || ^8.0"
    },
    "require-dev": {
        "easycorp/easyadmin-bundle": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/form": "^7.2 || ^8.0",
        "symfony/framework-bundle": "^7.2 || ^8.0",
        "symfony/property-access": "^7.2 || ^8.0",
        "symfony/security-http": "^7.2 || ^8.0"
    },
    "suggest": {
        "easycorp/easyadmin-bundle": "The admin CRUD, Mermaid diagram and guided transition form register only when EasyAdmin is present",
        "symfony/form": "The guided transition metadata form (registers only when installed)",
        "symfony/asset-mapper": "Ships the dependent from/to selects for the transition form"
    },
    "autoload": {
        "psr-4": {
            "WorkflowConfigurator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WorkflowConfigurator\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
