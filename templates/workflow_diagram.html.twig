{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ definition.label|default(definition.name) }} — diagram{% endblock %}

{% block main %}
    {% if unreachable is not empty %}
        <div class="alert alert-warning">
            Places not reachable from the initial place: {{ unreachable|join(', ') }}.
        </div>
    {% endif %}

    <div class="card">
        <div class="card-body" style="background: #fff;">
            <pre class="mermaid" style="text-align: center;">{{ mermaid }}</pre>
        </div>
    </div>

    <details class="mt-3">
        <summary>Mermaid source</summary>
        <pre>{{ mermaid }}</pre>
    </details>

    <script type="module">
        {# Rendered client-side; if the CDN is unreachable the raw definition
           above still shows (dev-only convenience, not a runtime dependency). #}
        try {
            const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
            mermaid.initialize({ startOnLoad: false });
            await mermaid.run();
        } catch (e) {
            console.warn('Mermaid failed to load; showing raw source only.', e);
        }
    </script>
{% endblock %}
